# 仅开发环境示例，不得提交真实Secret
HA_MYSQL_ROOT_PASSWORD=dev_only_change_me
HA_MYSQL_PORT=3306
HA_REDIS_PORT=6379

# 仅本机开发使用；不要提交真实值。
# 生成密钥：openssl rand -base64 48
AUTH_JWT_HMAC_KEY=replace_with_random_base64_value_at_least_32_bytes
AUTH_JWT_ISSUER=https://ha-ai.local
AUTH_JWT_TTL_SECONDS=3600
AUTH_BOOTSTRAP_ADMIN_USERNAME=local-admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_local_password_of_at_least_12_characters
